generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("MYSQL_DATABASE_URL")
}

model user {
  id                       String        @id @default(uuid())
  name                     String        @db.VarChar(99)
  email                    String        @unique @db.VarChar(99)
  password                 String?       @db.VarChar(100)
  refreshToken             String?       @db.Text
  role                     user_role     @default(USER)
  emailVerified            DateTime?
  emailVerificationToken   String?       @db.VarChar(100)
  emailVerificationExpires DateTime?
  passwordResetToken       String?       @db.VarChar(100)
  passwordResetExpires     DateTime?
  image                    String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  comments                 comment[]
  publications             publication[]
}

model publication {
  id        String    @id @default(uuid())
  title     String    @db.VarChar(100)
  text      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  comment   comment[]
  user      user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "publication_userId_fkey")
}

model comment {
  id            String      @id @default(uuid())
  text          String      @db.Text
  operation     String      @db.VarChar(100)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userId        String
  publicationId String
  publication   publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  predecessorId String?     @unique
  predecessor   comment?    @relation("PredecessorSuccessorComment", fields: [predecessorId], references: [id])
  successors    comment[]   @relation("PredecessorSuccessorComment")
  // @@index([publicationId], map: "comment_publicationId_fkey")
  // @@index([userId], map: "comment_userId_fkey")
}

enum user_role {
  ADMIN
  USER
}
